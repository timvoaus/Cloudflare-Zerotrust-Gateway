# =============================================================================
# REQUIRED: Cloudflare API Credentials
# =============================================================================
# Your Cloudflare Account ID (found in Cloudflare dashboard sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Your Cloudflare API Token (create at https://dash.cloudflare.com/profile/api-tokens)
# Required permissions: Zero Trust > Edit, Account > Read
CLOUDFLARE_API_TOKEN=

# (Optional) Cloudflare Gateway Location ID for DNS endpoints management.
# If not set, the first available location will be auto-detected from your account.
CLOUDFLARE_GATEWAY_LOCATION_ID=

# =============================================================================
# List Processing Settings
# =============================================================================
CLOUDFLARE_LIST_ITEM_LIMIT=300000
DRY_RUN=0
BLOCK_PAGE_ENABLED=0

# PATCH chunk size for Gateway list updates. Default: 500.
# Reduces the number of items sent per PATCH to avoid body size limits.
GATEWAY_PATCH_CHUNK_SIZE=500

# API concurrency for Cloudflare Gateway operations. Default: 3.
# Controls how many parallel API requests to make for read-only operations.
# Higher values may trigger rate limits (429 errors).
CZGS_API_CONCURRENCY=3

# Download concurrency for fetching blocklist/allowlist sources. Default: 3.
# Controls parallel downloads from external servers.
CZGS_DOWNLOAD_CONCURRENCY=3

# Skip Cloudflare list sync if blocklist/allowlist are unchanged. Default: 1 (enabled).
# Speeds up repeat runs by comparing SHA-256 hashes of processed domains.
# Set to 0 to always sync even when unchanged.
CZGS_SKIP_SYNC_IF_UNCHANGED=1

# Force Cloudflare list sync even if unchanged. Default: 0 (disabled).
# Overrides CZGS_SKIP_SYNC_IF_UNCHANGED when set to 1.
# Use this if you manually edited Cloudflare lists and need to reconcile.
CZGS_FORCE_SYNC=0

# Auto-defragment after update. Default: 0 (disabled).
# Automatically cleans up empty lists after each update.
# WARNING: May increase API usage. Enable only if you have small list counts (< 20).
# Set to 1 to enable auto-defragment, or use the Defragment button manually.
CZGS_AUTO_DEFRAGMENT=0

# Traffic map GraphQL aggregate sync and local SQLite cache behavior.
# GraphQL sync uses Cloudflare analytics aggregates and stores 24h tables plus daily snapshots locally.
# TRAFFIC_MAP_HOURS is hard-capped at 24 because Cloudflare Gateway analytics history is short-lived on many plans.
# TRAFFIC_MAP_ROW_LIMIT controls the maximum grouped rows requested from GraphQL per dimension.
# TRAFFIC_MAP_SYNC_COOLDOWN_SECONDS prevents repeated Cloudflare API calls when users refresh/open the dashboard.
TRAFFIC_MAP_HOURS=24
TRAFFIC_MAP_ROW_LIMIT=10000
TRAFFIC_MAP_SYNC_COOLDOWN_SECONDS=300
TRAFFIC_MAP_DISPLAY_HOURS=0
TRAFFIC_MAP_RETENTION_DAYS=30
TRAFFIC_MAP_ACTIVITY_LIMIT=5000
TRAFFIC_MAP_MAX_ACTIVITY_PAGES=20

# Dashboard access. Localhost works without a password, but remote access is
# blocked unless DASHBOARD_PASSWORD is set or DASHBOARD_AUTH_DISABLED=1.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_AUTH_DISABLED=0

# (Optional) Comma-separated list of allowed CORS origins for WebSocket connections.
# Example: DASHBOARD_ALLOWED_ORIGINS=https://czgs.example.com,https://admin.example.com
DASHBOARD_ALLOWED_ORIGINS=

# (Optional) Discord webhook URL for notifications.
# Sends notifications when sync operations complete or fail.
DISCORD_WEBHOOK_URL=

# Experimental SNI based filtering. Set to 1 to enable.
# Information about SNI: https://www.cloudflare.com/learning/ssl/what-is-sni/
BLOCK_BASED_ON_SNI=0

# Enable deletion of lists and rules via menu/scripts. Default: unset (disabled).
# Set to 1 to enable deletion operations. Not required for defragment (uses its own flow).
CZGS_DELETION_ENABLED=0

# Debug mode. Set to 1 to enable verbose logging.
DEBUG=0

# =============================================================================
# Custom Blocklist/Allowlist URLs
# =============================================================================
# The following lists will be used instead of the recommended ones if you enter any.
# Multiline is supported: https://github.com/motdotla/dotenv#multiline-values
ALLOWLIST_URLS="https://adguardteam.github.io/HostlistsRegistry/assets/filter_45.txt
https://raw.githubusercontent.com/AdguardTeam/HttpsExclusions/master/exclusions/banks.txt
https://raw.githubusercontent.com/Dogino/Discord-Phishing-URLs/main/official-domains.txt
https://raw.githubusercontent.com/AdguardTeam/HttpsExclusions/master/exclusions/mac.txt
https://raw.githubusercontent.com/AdguardTeam/HttpsExclusions/master/exclusions/windows.txt
https://raw.githubusercontent.com/boutetnico/url-shorteners/master/list.txt
https://raw.githubusercontent.com/AdguardTeam/HttpsExclusions/master/exclusions/firefox.txt
https://raw.githubusercontent.com/AdguardTeam/HttpsExclusions/master/exclusions/android.txt
https://raw.githubusercontent.com/TogoFire-Home/AD-Settings/main/Filters/whitelist.txt
https://raw.githubusercontent.com/DandelionSprout/AdGuard-Home-Whitelist/master/whitelist.txt
https://raw.githubusercontent.com/AdguardTeam/AdGuardSDNSFilter/master/Filters/exclusions.txt
https://raw.githubusercontent.com/AdguardTeam/HttpsExclusions/master/exclusions/issues.txt"
BLOCKLIST_URLS="https://raw.githubusercontent.com/bigdargon/hostsVN/master/filters/adservers-all.txt
https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
https://adguardteam.github.io/HostlistsRegistry/assets/filter_5.txt
https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/multi-onlydomains.txt
https://adguardteam.github.io/HostlistsRegistry/assets/filter_16.txt"


# Disable dotenv ads ("tips"). You don't need to touch this value.
# More details: https://github.com/motdotla/dotenv/issues/899
DOTENV_CONFIG_QUIET=true
